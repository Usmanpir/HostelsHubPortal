// ─────────────────────────────────────────────────────────────────────────────
// Identity & authentication
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  passwordHash     String
  emailVerifiedAt  DateTime?
  image            String?
  phone            String?
  isSuperAdmin     Boolean    @default(false)
  status           UserStatus @default(ACTIVE)
  locale           String     @default("en")
  // Incremented to invalidate all existing sessions (password change, disable).
  sessionVersion   Int        @default(0)
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  memberships          OrganizationMember[]
  residentProfiles     Resident[]
  staffProfiles        Staff[]
  passwordResetTokens  PasswordResetToken[]
  verificationTokens   EmailVerificationToken[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  invitationsSent      Invitation[]             @relation("InvitedBy")
  uploadedFiles        StoredFile[]
  paymentsReceived     Payment[]                @relation("PaymentReceivedBy")
  expensesCreated      Expense[]
  announcements        Announcement[]
  complaintsSubmitted  Complaint[]              @relation("ComplaintSubmittedBy")
  maintenanceReported  MaintenanceRequest[]     @relation("MaintenanceReportedBy")
  attendanceMarked     StaffAttendance[]
  invoicesCreated      Invoice[]
  assignmentsCreated   ResidentAssignment[]
  visitorsRecorded     Visitor[]
  leavesReviewed       StaffLeave[]
  requestsReviewed     ResidentRequest[]        @relation("RequestReviewedBy")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Fixed-window rate limit counters (see src/lib/security/rate-limit.ts).
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Organizations (tenants), membership, RBAC
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id       String             @id @default(cuid())
  name     String
  slug     String             @unique
  logoFileId String?          @unique
  email    String?
  phone    String?
  address  String?
  city     String?
  country  String?
  timezone String             @default("Asia/Karachi")
  currency String             @default("PKR")
  locale   String             @default("en")
  status   OrganizationStatus @default(ACTIVE)

  // White-label readiness
  brandName        String?
  primaryColor     String?
  customDomain     String? @unique
  emailSenderName  String?
  emailSenderAddress String?

  // Invoice settings
  invoicePrefix  String  @default("INV")
  receiptPrefix  String  @default("RCP")
  invoiceDueDays Int     @default(7)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  taxLabel       String? @default("Tax")
  invoiceFooter  String?

  // { "email": true, "sms": false, "events": { "PAYMENT_RECEIVED": true, ... } }
  notificationSettings Json @default("{}")

  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  logo              StoredFile?          @relation("OrganizationLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  members           OrganizationMember[]
  roles             Role[]
  invitations       Invitation[]
  subscription      Subscription?
  hostels           Hostel[]
  floors            Floor[]
  rooms             Room[]
  beds              Bed[]
  residents         Resident[]
  residentDocuments ResidentDocument[]
  assignments       ResidentAssignment[]
  staff             Staff[]
  staffDocuments    StaffDocument[]
  staffAttendance   StaffAttendance[]
  staffLeaves       StaffLeave[]
  payrolls          Payroll[]
  invoices          Invoice[]
  payments          Payment[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  maintenance       MaintenanceRequest[]
  complaints        Complaint[]
  visitors          Visitor[]
  announcements     Announcement[]
  residentRequests  ResidentRequest[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  files             StoredFile[]         @relation("OrganizationFiles")
  sequences         Sequence[]
  featureOverrides  OrganizationFeatureFlag[]

  @@index([status])
}

// Organization-scoped role. System roles (isSystem) are created from templates
// in src/lib/permissions/roles.ts when an organization is created; owners may
// add custom roles with any subset of the permission catalog.
model Role {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  // Members with this role see every hostel unless restricted per member.
  defaultAllHostels Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]
  invitations  Invitation[]

  @@unique([organizationId, key])
}

// Permission keys are defined in code (src/lib/permissions/catalog.ts) because
// code checks them; this table records which keys a role has been granted.
model RolePermission {
  roleId     String
  permission String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  status         MemberStatus @default(ACTIVE)
  // true = access to every hostel in the organization; false = only hostels
  // listed in hostelAccess.
  allHostels     Boolean      @default(false)
  isOwner        Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  hostelAccess MemberHostelAccess[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
}

model MemberHostelAccess {
  memberId String
  hostelId String

  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  hostel Hostel             @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@id([memberId, hostelId])
  @@index([hostelId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  roleId         String
  allHostels     Boolean   @default(false)
  hostelIds      String[]
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

// Per-organization counters for human-readable numbers (INV-00012, RES-0042…).
model Sequence {
  organizationId String
  key            String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
}

// ─────────────────────────────────────────────────────────────────────────────
// SaaS plans & subscriptions
// ─────────────────────────────────────────────────────────────────────────────

model Plan {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  priceMonthly Decimal  @default(0) @db.Decimal(12, 2)
  priceYearly  Decimal  @default(0) @db.Decimal(12, 2)
  currency     String   @default("USD")
  trialDays    Int      @default(14)
  // { maxHostels, maxBeds, maxResidents, maxStaff, maxStorageMb } — null = unlimited
  limits       Json     @default("{}")
  // Feature keys enabled on this plan, e.g. ["reports.advanced", "branding.custom"]
  features     String[]
  isPublic     Boolean  @default(true)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                     String             @id @default(cuid())
  organizationId         String             @unique
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  interval               BillingInterval    @default(MONTHLY)
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  canceledAt             DateTime?
  // Payment provider abstraction: "manual" today, "stripe" etc. later.
  provider               String             @default("manual")
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([planId])
}

model FeatureFlag {
  key         String   @id
  description String?
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  overrides OrganizationFeatureFlag[]
}

model OrganizationFeatureFlag {
  organizationId String
  flagKey        String
  enabled        Boolean

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  flag         FeatureFlag  @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@id([organizationId, flagKey])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Property structure: Hostel → Floor → Room → Bed
// ─────────────────────────────────────────────────────────────────────────────

model Hostel {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  type           HostelType   @default(OTHER)
  gender         HostelGender @default(MIXED)
  address        String?
  city           String?
  country        String?
  phone          String?
  email          String?
  managerStaffId String?
  description    String?
  amenities      String[]
  rules          String?
  status         HostelStatus @default(ACTIVE)

  // Rent configuration
  defaultBedRent   Decimal? @db.Decimal(12, 2)
  defaultDeposit   Decimal? @db.Decimal(12, 2)
  admissionFee     Decimal? @db.Decimal(12, 2)
  rentDueDay       Int      @default(5)
  lateFeeAmount    Decimal? @db.Decimal(12, 2)
  lateFeeGraceDays Int      @default(5)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  manager          Staff?                  @relation("HostelManager", fields: [managerStaffId], references: [id], onDelete: SetNull)
  floors           Floor[]
  rooms            Room[]
  beds             Bed[]
  residents        Resident[]
  assignments      ResidentAssignment[]
  staffAssignments StaffHostelAssignment[]
  memberAccess     MemberHostelAccess[]
  attendance       StaffAttendance[]
  invoices         Invoice[]
  payments         Payment[]
  expenses         Expense[]
  maintenance      MaintenanceRequest[]
  complaints       Complaint[]
  visitors         Visitor[]
  announcements    Announcement[]
  residentRequests ResidentRequest[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Floor {
  id             String    @id @default(cuid())
  organizationId String
  hostelId       String
  name           String
  floorNumber    Int
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel       Hostel       @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  rooms        Room[]

  @@unique([hostelId, floorNumber])
  @@index([organizationId, hostelId])
}

model Room {
  id             String     @id @default(cuid())
  organizationId String
  hostelId       String
  floorId        String
  roomNumber     String
  roomType       RoomType   @default(SHARED)
  capacity       Int
  status         RoomStatus @default(AVAILABLE)
  rent           Decimal?   @db.Decimal(12, 2)
  description    String?
  amenities      String[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  archivedAt     DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel       Hostel               @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  floor        Floor                @relation(fields: [floorId], references: [id], onDelete: Restrict)
  beds         Bed[]
  assignments  ResidentAssignment[]
  maintenance  MaintenanceRequest[]

  @@unique([hostelId, roomNumber])
  @@index([organizationId, hostelId, status])
  @@index([floorId])
}

model Bed {
  id             String    @id @default(cuid())
  organizationId String
  hostelId       String
  roomId         String
  bedNumber      String
  status         BedStatus @default(AVAILABLE)
  monthlyRent    Decimal?  @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel       Hostel               @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room         Room                 @relation(fields: [roomId], references: [id], onDelete: Restrict)
  assignments  ResidentAssignment[]
  maintenance  MaintenanceRequest[]

  @@unique([roomId, bedNumber])
  @@index([organizationId, hostelId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Residents
// ─────────────────────────────────────────────────────────────────────────────

model Resident {
  id             String         @id @default(cuid())
  organizationId String
  // Hostel the resident is registered with (updated on cross-hostel transfer).
  hostelId       String
  userId         String?
  residentCode   String
  firstName      String
  lastName       String
  email          String?
  phone          String
  alternatePhone String?
  gender         Gender?
  dateOfBirth    DateTime?      @db.Date
  idNumber       String?
  nationality    String?
  photoFileId    String?        @unique
  address        String?
  city           String?
  occupation     String?
  institution    String?
  joiningDate    DateTime       @db.Date
  expectedLeavingDate DateTime? @db.Date
  actualLeavingDate   DateTime? @db.Date
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  guardianName   String?
  guardianPhone  String?
  status         ResidentStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?

  organization  Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel        Hostel               @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  photo         StoredFile?          @relation("ResidentPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  documents     ResidentDocument[]
  assignments   ResidentAssignment[]
  invoices      Invoice[]
  payments      Payment[]
  maintenance   MaintenanceRequest[]
  complaints    Complaint[]
  visitors      Visitor[]
  requests      ResidentRequest[]
  announcements AnnouncementRecipient[]

  @@unique([organizationId, residentCode])
  @@unique([organizationId, userId])
  @@index([organizationId, hostelId, status])
  @@index([organizationId, lastName, firstName])
  @@index([organizationId, phone])
}

model ResidentDocument {
  id             String               @id @default(cuid())
  organizationId String
  residentId     String
  fileId         String               @unique
  type           ResidentDocumentType
  title          String
  createdAt      DateTime             @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resident     Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)
  file         StoredFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([organizationId, residentId])
}

// Historical record of every bed a resident has occupied or reserved.
// Business-rule enforcement at the database level:
//   activeBedId      = bedId      while RESERVED/ACTIVE, else NULL  (UNIQUE)
//   activeResidentId = residentId while RESERVED/ACTIVE, else NULL  (UNIQUE)
// PostgreSQL allows many NULLs in a unique column, so this guarantees one live
// assignment per bed and per resident without partial indexes.
model ResidentAssignment {
  id               String           @id @default(cuid())
  organizationId   String
  residentId       String
  hostelId         String
  roomId           String
  bedId            String
  status           AssignmentStatus @default(ACTIVE)
  checkInDate      DateTime         @db.Date
  checkOutDate     DateTime?        @db.Date
  monthlyRent      Decimal          @db.Decimal(12, 2)
  securityDeposit  Decimal          @default(0) @db.Decimal(12, 2)
  activeBedId      String?          @unique
  activeResidentId String?          @unique
  // Check-out settlement
  finalCharges     Decimal?         @db.Decimal(12, 2)
  depositDeduction Decimal?         @db.Decimal(12, 2)
  depositRefund    Decimal?         @db.Decimal(12, 2)
  meterReading     String?
  endReason        String?
  notes            String?
  previousAssignmentId String?      @unique
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resident           Resident            @relation(fields: [residentId], references: [id], onDelete: Restrict)
  hostel             Hostel              @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  room               Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  bed                Bed                 @relation(fields: [bedId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  previousAssignment ResidentAssignment? @relation("AssignmentTransfer", fields: [previousAssignmentId], references: [id], onDelete: SetNull)
  nextAssignment     ResidentAssignment? @relation("AssignmentTransfer")
  invoices           Invoice[]

  @@index([organizationId, hostelId, status])
  @@index([residentId, checkInDate])
  @@index([bedId])
  @@index([organizationId, checkInDate])
  @@index([organizationId, checkOutDate])
}

model ResidentRequest {
  id             String              @id @default(cuid())
  organizationId String
  hostelId       String
  residentId     String
  type           ResidentRequestType
  subject        String
  details        String?
  startDate      DateTime?           @db.Date
  endDate        DateTime?           @db.Date
  status         ApprovalStatus      @default(PENDING)
  response       String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel       Hostel       @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  resident     Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("RequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, hostelId, status])
  @@index([residentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Staff
// ─────────────────────────────────────────────────────────────────────────────

model Staff {
  id             String         @id @default(cuid())
  organizationId String
  userId         String?
  employeeCode   String
  firstName      String
  lastName       String
  phone          String
  email          String?
  idNumber       String?
  address        String?
  dateOfBirth    DateTime?      @db.Date
  joiningDate    DateTime       @db.Date
  designation    StaffType      @default(OTHER)
  department     String?
  salary         Decimal        @default(0) @db.Decimal(12, 2)
  employmentType EmploymentType @default(FULL_TIME)
  status         StaffStatus    @default(ACTIVE)
  photoFileId    String?        @unique
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  archivedAt     DateTime?

  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  photo              StoredFile?             @relation("StaffPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  hostels            StaffHostelAssignment[]
  documents          StaffDocument[]
  attendance         StaffAttendance[]
  leaves             StaffLeave[]
  payrolls           Payroll[]
  managedHostels     Hostel[]                @relation("HostelManager")
  maintenanceTasks   MaintenanceRequest[]
  complaintsAssigned Complaint[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([userId])
}

model StaffHostelAssignment {
  staffId   String
  hostelId  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  hostel Hostel @relation(fields: [hostelId], references: [id], onDelete: Cascade)

  @@id([staffId, hostelId])
  @@index([hostelId])
}

model StaffDocument {
  id             String            @id @default(cuid())
  organizationId String
  staffId        String
  fileId         String            @unique
  type           StaffDocumentType
  title          String
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  file         StoredFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([organizationId, staffId])
}

model StaffAttendance {
  id             String           @id @default(cuid())
  organizationId String
  staffId        String
  hostelId       String?
  date           DateTime         @db.Date
  status         AttendanceStatus
  checkInTime    String?
  checkOutTime   String?
  notes          String?
  markedById     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  hostel       Hostel?      @relation(fields: [hostelId], references: [id], onDelete: SetNull)
  markedBy     User?        @relation(fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([staffId, date])
  @@index([organizationId, date])
}

model StaffLeave {
  id             String         @id @default(cuid())
  organizationId String
  staffId        String
  type           LeaveType
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  reason         String?
  status         ApprovalStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([staffId, startDate])
}

model Payroll {
  id             String         @id @default(cuid())
  organizationId String
  staffId        String
  year           Int
  month          Int
  baseSalary     Decimal        @db.Decimal(12, 2)
  allowances     Decimal        @default(0) @db.Decimal(12, 2)
  bonus          Decimal        @default(0) @db.Decimal(12, 2)
  deductions     Decimal        @default(0) @db.Decimal(12, 2)
  advances       Decimal        @default(0) @db.Decimal(12, 2)
  netSalary      Decimal        @db.Decimal(12, 2)
  status         PayrollStatus  @default(PENDING)
  paymentDate    DateTime?      @db.Date
  paymentMethod  PaymentMethod?
  reference      String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@unique([staffId, year, month])
  @@index([organizationId, year, month])
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing: invoices, payments, expenses
// ─────────────────────────────────────────────────────────────────────────────

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  hostelId       String
  residentId     String
  assignmentId   String?
  invoiceNumber  String
  periodStart    DateTime?     @db.Date
  periodEnd      DateTime?     @db.Date
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(PENDING)
  notes          String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel       Hostel              @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  resident     Resident            @relation(fields: [residentId], references: [id], onDelete: Restrict)
  assignment   ResidentAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdBy    User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, hostelId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, issueDate])
  @@index([residentId])
}

model InvoiceItem {
  id          String     @id @default(cuid())
  invoiceId   String
  type        ChargeType
  description String
  quantity    Decimal    @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal    @db.Decimal(12, 2)
  amount      Decimal    @db.Decimal(12, 2)
  sortOrder   Int        @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  hostelId       String
  residentId     String
  invoiceId      String?
  receiptNumber  String
  type           PaymentType   @default(PAYMENT)
  status         PaymentStatus @default(COMPLETED)
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  paymentDate    DateTime      @db.Date
  notes          String?
  receivedById   String?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel       Hostel       @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  resident     Resident     @relation(fields: [residentId], references: [id], onDelete: Restrict)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  receivedBy   User?        @relation("PaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, hostelId, paymentDate])
  @@index([invoiceId])
  @@index([residentId])
}

model ExpenseCategory {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, key])
}

model Expense {
  id             String        @id @default(cuid())
  organizationId String
  hostelId       String
  categoryId     String
  amount         Decimal       @db.Decimal(12, 2)
  date           DateTime      @db.Date
  vendor         String?
  description    String?
  paymentMethod  PaymentMethod @default(CASH)
  reference      String?
  receiptFileId  String?       @unique
  status         ExpenseStatus @default(RECORDED)
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel       Hostel          @relation(fields: [hostelId], references: [id], onDelete: Restrict)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  receipt      StoredFile?     @relation("ExpenseReceipt", fields: [receiptFileId], references: [id], onDelete: SetNull)
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, hostelId, date])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Operations
// ─────────────────────────────────────────────────────────────────────────────

model MaintenanceRequest {
  id              String              @id @default(cuid())
  organizationId  String
  hostelId        String
  requestNumber   String
  roomId          String?
  bedId           String?
  residentId      String?
  category        MaintenanceCategory
  priority        Priority            @default(MEDIUM)
  title           String
  description     String?
  assignedStaffId String?
  status          MaintenanceStatus   @default(OPEN)
  resolutionNotes String?
  completedAt     DateTime?
  reportedById    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel        Hostel       @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  room          Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  bed           Bed?         @relation(fields: [bedId], references: [id], onDelete: SetNull)
  resident      Resident?    @relation(fields: [residentId], references: [id], onDelete: SetNull)
  assignedStaff Staff?       @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)
  reportedBy    User?        @relation("MaintenanceReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  photos        StoredFile[] @relation("MaintenancePhotos")

  @@unique([organizationId, requestNumber])
  @@index([organizationId, hostelId, status])
  @@index([assignedStaffId])
  @@index([residentId])
}

model Complaint {
  id              String            @id @default(cuid())
  organizationId  String
  hostelId        String
  complaintNumber String
  residentId      String?
  submittedById   String?
  category        ComplaintCategory
  title           String
  description     String
  priority        Priority          @default(MEDIUM)
  status          ComplaintStatus   @default(OPEN)
  assignedStaffId String?
  resolution      String?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel        Hostel       @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  resident      Resident?    @relation(fields: [residentId], references: [id], onDelete: SetNull)
  submittedBy   User?        @relation("ComplaintSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  assignedStaff Staff?       @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@unique([organizationId, complaintNumber])
  @@index([organizationId, hostelId, status])
  @@index([residentId])
}

model Visitor {
  id             String    @id @default(cuid())
  organizationId String
  hostelId       String
  residentId     String?
  name           String
  phone          String?
  idNumber       String?
  purpose        String?
  checkInAt      DateTime  @default(now())
  checkOutAt     DateTime?
  notes          String?
  recordedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel       Hostel       @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  resident     Resident?    @relation(fields: [residentId], references: [id], onDelete: SetNull)
  recordedBy   User?        @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([organizationId, hostelId, checkInAt])
  @@index([residentId])
}

model Announcement {
  id             String               @id @default(cuid())
  organizationId String
  // null = whole organization
  hostelId       String?
  title          String
  body           String
  category       AnnouncementCategory @default(GENERAL)
  audience       AnnouncementAudience @default(EVERYONE)
  isPinned       Boolean              @default(false)
  publishedAt    DateTime             @default(now())
  expiresAt      DateTime?
  createdById    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  archivedAt     DateTime?

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  hostel       Hostel?                 @relation(fields: [hostelId], references: [id], onDelete: Cascade)
  createdBy    User?                   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  recipients   AnnouncementRecipient[]

  @@index([organizationId, hostelId, publishedAt])
}

model AnnouncementRecipient {
  announcementId String
  residentId     String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  resident     Resident     @relation(fields: [residentId], references: [id], onDelete: Cascade)

  @@id([announcementId, residentId])
  @@index([residentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform infrastructure: notifications, files, audit
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  body           String?
  link           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, readAt])
  @@index([userId, createdAt])
}

// Private file metadata. The bytes live in the storage provider under `key`;
// files are only served through /api/files/[id] after an authorization check.
model StoredFile {
  id             String    @id @default(cuid())
  organizationId String
  key            String    @unique
  originalName   String
  mimeType       String
  size           Int
  // "resident-document" | "staff-document" | "logo" | "expense-receipt" | "maintenance-photo" | ...
  purpose        String
  maintenanceRequestId String?
  uploadedById   String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization       Organization        @relation("OrganizationFiles", fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy         User?               @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  maintenanceRequest MaintenanceRequest? @relation("MaintenancePhotos", fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  organizationLogo   Organization?       @relation("OrganizationLogo")
  residentPhoto      Resident?           @relation("ResidentPhoto")
  staffPhoto         Staff?              @relation("StaffPhoto")
  expenseReceipt     Expense?            @relation("ExpenseReceipt")
  residentDocument   ResidentDocument?
  staffDocument      StaffDocument?

  @@index([organizationId, purpose])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  entityType     String
  entityId       String?
  // { before?: {...}, after?: {...}, ...extra }
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([userId, createdAt])
}
