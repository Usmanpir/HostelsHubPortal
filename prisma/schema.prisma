// Multi-tenant Hostel Management SaaS — database schema.
//
// Tenancy rule: every tenant-owned row carries `organizationId`. Services must
// always filter by the organization resolved from the authenticated session,
// never by an organizationId supplied by the client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum HostelType {
  BOYS
  GIRLS
  FAMILY
  STUDENT
  WORKING_PROFESSIONALS
  MIXED
  OTHER
}

enum HostelGender {
  MALE
  FEMALE
  MIXED
}

enum HostelStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum RoomType {
  SINGLE
  DOUBLE
  TRIPLE
  FOUR_BED
  SHARED
  CUSTOM
}

enum RoomStatus {
  AVAILABLE
  PARTIALLY_OCCUPIED
  FULL
  MAINTENANCE
  RESERVED
  INACTIVE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ResidentStatus {
  ACTIVE
  NOTICE
  CHECKED_OUT
  SUSPENDED
  ARCHIVED
}

enum ResidentDocumentType {
  ID_DOCUMENT
  PHOTO
  ADMISSION_FORM
  AGREEMENT
  CLEARANCE
  OTHER
}

enum AssignmentStatus {
  RESERVED
  ACTIVE
  TRANSFERRED
  COMPLETED
  CANCELLED
}

enum StaffType {
  MANAGER
  WARDEN
  RECEPTIONIST
  SECURITY_GUARD
  CLEANER
  COOK
  MAINTENANCE
  ACCOUNTANT
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
  RESIGNED
}

enum StaffDocumentType {
  ID_DOCUMENT
  PHOTO
  CONTRACT
  CERTIFICATE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

enum LeaveType {
  CASUAL
  SICK
  ANNUAL
  UNPAID
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  PENDING
  PAID
  CANCELLED
}

enum ChargeType {
  MONTHLY_RENT
  SECURITY_DEPOSIT
  ADMISSION_FEE
  ELECTRICITY
  GAS
  INTERNET
  MESS
  LAUNDRY
  MAINTENANCE
  LATE_FEE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  OTHER
}

enum PaymentType {
  PAYMENT
  ADVANCE
  REFUND
}

enum PaymentStatus {
  COMPLETED
  VOIDED
}

enum ExpenseStatus {
  RECORDED
  VOIDED
}

enum MaintenanceCategory {
  ELECTRICITY
  PLUMBING
  AC
  FURNITURE
  INTERNET
  CLEANING
  WATER
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ComplaintCategory {
  ROOM
  FOOD
  CLEANLINESS
  NOISE
  STAFF
  SECURITY
  BILLING
  FACILITIES
  OTHER
}

enum ComplaintStatus {
  OPEN
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AnnouncementAudience {
  EVERYONE
  RESIDENTS
  STAFF
  SPECIFIC_RESIDENTS
}

enum AnnouncementCategory {
  GENERAL
  RENT_REMINDER
  MAINTENANCE
  RULES
  EMERGENCY
  EVENT
}

enum ResidentRequestType {
  ROOM_CHANGE
  LEAVE
  OTHER
}

enum NotificationType {
  RENT_DUE
  PAYMENT_RECEIVED
  INVOICE_CREATED
  COMPLAINT_UPDATED
  MAINTENANCE_UPDATED
  ROOM_ASSIGNED
  ROOM_TRANSFER
  ANNOUNCEMENT
  CHECK_IN
  CHECK_OUT
  REQUEST_UPDATED
  SYSTEM
