# ─── Database ────────────────────────────────────────────────────────────────
# Local development uses the Postgres service from docker-compose.yml.
DATABASE_URL="postgresql://hostel:hostel@localhost:5440/hostel_saas?schema=public"
# Integration tests run against a separate database (created by docker/init-test-db.sql).
TEST_DATABASE_URL="postgresql://hostel:hostel@localhost:5440/hostel_saas_test?schema=public"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Public base URL of the app (used in emails and auth callbacks).
NEXTAUTH_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"
# Set to "true" on hosts other than Vercel that sit behind a trusted proxy.
AUTH_TRUST_HOST="true"

# ─── File storage ────────────────────────────────────────────────────────────
# "local" stores files in ./.storage (development only, not persistent on Vercel).
# "s3" works with AWS S3, Cloudflare R2, MinIO, Backblaze B2, DigitalOcean Spaces…
STORAGE_DRIVER="local"
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
# Max upload size in megabytes.
STORAGE_MAX_FILE_MB="10"

# ─── Email ───────────────────────────────────────────────────────────────────
# SMTP connection string, e.g. smtp://user:pass@smtp.example.com:587
# Leave empty in development: emails are logged to the server console instead.
EMAIL_SERVER=""
EMAIL_FROM="Hostel Manager <no-reply@example.com>"

# ─── Platform ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="HostelHub"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Require email verification before login (true/false).
REQUIRE_EMAIL_VERIFICATION="false"

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Shared secret for /api/cron/daily (Vercel Cron sends it as a Bearer token).
CRON_SECRET="replace-with-a-random-string"


# Inbox for 'Book a demo' requests from the landing page (defaults to EMAIL_FROM).
SALES_EMAIL=""


# ─── AI assistant ────────────────────────────────────────────────────────────
# Google Gemini API key for the in-app assistant (leave empty to disable it).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional model override (default: gemini-flash-latest, available on the free tier).
GEMINI_MODEL=""

# Model used when the main one is overloaded (default: gemini-flash-lite-latest).
GEMINI_FALLBACK_MODEL=""


# ─── Online rent payments (JazzCash / Easypaisa) ─────────────────────────────
# Each organization connects its own merchant accounts in Settings → Online payments.
# Their secrets are stored AES-256-GCM encrypted with this key (32 random bytes, base64):
#   openssl rand -base64 32
# If unset, a key is derived from AUTH_SECRET (a warning is logged in production).
# Keep it stable: changing it makes saved gateway credentials unreadable.
PAYMENTS_ENCRYPTION_KEY=""
# "true" enables a local payment simulator (Approve / Decline page) for development.
# Ignored when NODE_ENV=production.
PAYMENTS_SIMULATOR="false"
