    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/node": "^22.20.4",
        "@types/nodemailer": "^8.0.2",
        "@types/pg": "^8.23.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "dotenv": "^18.0.4",
        "eslint": "^9",
        "eslint-config-next": "16.3.6",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.2"
